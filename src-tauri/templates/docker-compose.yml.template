version: '3'
name: tarasqueproxy
services:
  nginx:
    image: nginx:1.25-alpine
    container_name: tarasque-nginx
    ports:
      - "443:443"
    volumes:
      - {CONF_DIR}/nginx.conf:/etc/nginx/nginx.conf
      - {CONF_DIR}/conf.d:/etc/nginx/conf.d
      - {CERT_DIR}:/usr/local/ssl/cert
    extra_hosts:
      - "host.docker.internal:host-gateway"
